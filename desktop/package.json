{
  "name": "nursery-billing-desktop",
  "version": "1.0.0",
  "description": "Desktop Application for Gangadhara Nursery Business Management",
  "main": "main.js",
  "author": "Gangadhara Nursery",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:web": "cd ../frontend && npm run build",
    "dist": "npm run build:web && electron-builder --win dir",
    "dist:portable": "npm run build:web && electron-builder --win portable"
  },
  "dependencies": {
    "electron-serve": "^1.3.0"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nursery.billing.desktop",
    "productName": "Gangadhara Nursery Billing",
    "copyright": "Copyright © 2026 Gangadhara Nursery",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "main.js",
      "preload.js",
      "../frontend/dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    }
  }
}
