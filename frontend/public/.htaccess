<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass API calls directly to PHP without rewriting
  RewriteRule ^api/(.*)$ - [L]

  # Serve existing static files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all React Router client routes to index.html
  RewriteRule ^ index.html [L]
</IfModule>
